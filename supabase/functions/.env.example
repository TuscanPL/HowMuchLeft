CRON_SECRET=local-cron-secret
# Enable Banking (https://enablebanking.com/cp/applications): the application id
# and its private key (PEM, PKCS#8). For local work use a sandbox application.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Comma-separated URLs the bank may send people back to (the app's bank-callback page).
APP_URLS=http://localhost:5173/
